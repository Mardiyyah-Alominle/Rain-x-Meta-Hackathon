{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ],
    "env": {
        "FIREBASE_PROJECT_ID": "@firebase_project_id",
        "FIREBASE_CLIENT_EMAIL": "@firebase_client_email",
        "FIREBASE_PRIVATE_KEY": "@firebase_private_key",
        "GROQ_API_KEY": "@groq_api_key",
        "TELEGRAM_BOT_TOKEN": "@telegram_bot_token"
    }
}